auto-install-peers=true
strict-peer-dependencies=false

# sharp is an optional dependency of Next.js used only by next/image, which
# this site does not use — every image is a plain <img>. Its native
# post-install script is therefore dead weight, and pnpm blocking it is
# harmless. Without this, a CI `--frozen-lockfile` install treats the skipped
# build as fatal (ERR_PNPM_IGNORED_BUILDS) and fails the deploy.
strict-dep-builds=false
