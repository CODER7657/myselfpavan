{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter @foundry/web start",
      "startServerReadyPattern": "Ready in|started server",
      "startServerReadyTimeout": 60000,
      "url": ["http://localhost:3210/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.6, "aggregationMethod": "median-run""minScore": 0.7, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "pessimistic" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
