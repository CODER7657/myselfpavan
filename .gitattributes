# Store text with LF in the repository, whatever the committer's OS or git
# settings; check out Windows scripts with CRLF. Binary files are detected.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be touched.
*.png binary
*.webp binary
*.jpg binary
*.woff binary
*.woff2 binary
*.ttf binary

# Keep generated art and the lockfile out of diff noise and language stats.
apps/web/public/art/* linguist-generated=true
pnpm-lock.yaml linguist-generated=true -diff
